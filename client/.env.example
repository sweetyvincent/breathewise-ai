# Frontend environment (Vite). Only PUBLIC values belong here; they are embedded in the browser bundle.
# Leave VITE_API_URL empty in development: the Vite dev server proxies /api to http://localhost:8787.
VITE_API_URL=
# Optional: enable real sign-up/login with Supabase Auth. The anon key is designed to be public (protected by Row Level Security).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
