# ─── BreatheWise API environment ───
# Copy to .env (never commit .env). Everything is optional: with no keys the API runs in DEMO MODE
# (clearly-labelled simulated air data, built-in rules engine, in-memory storage, demo login).

NODE_ENV=development
PORT=8787

# Comma-separated list of front-end origins allowed by CORS (your Vercel/Netlify URL in production).
CORS_ORIGINS=http://localhost:5173

# ── Live air quality + weather + geocoding: https://openweathermap.org/api (free tier works) ──
OPENWEATHER_API_KEY=

# ── Generative AI: https://platform.openai.com/api-keys ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Database + auth: Supabase → Project Settings → API. The SERVICE ROLE key is a server secret: never put it in the front end. ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Allow the one-click "Continue as demo user" login (isolated in-memory sessions, `Bearer demo-<id>`).
# Defaults to on in development when Supabase is not configured, and OFF in production. Set true to let judges try a deployed demo.
DEMO_MODE=false

# Rate limits
RATE_LIMIT_GENERAL_PER_MIN=120
RATE_LIMIT_AI_PER_MIN=15
RATE_LIMIT_WRITE_PER_HOUR=20
